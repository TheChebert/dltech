{
  "name": "dltech",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "sdk:typecheck": "tsc -p packages/licensing-sdk/tsconfig.json --noEmit",
    "sdk:dotnet:build": "dotnet build packages/Driftline.Licensing/Driftline.Licensing.csproj --configuration Release",
    "sdk:dotnet:test": "dotnet test packages/Driftline.Licensing.Tests/Driftline.Licensing.Tests.csproj --configuration Release",
    "sdk:dotnet:pack": "dotnet pack packages/Driftline.Licensing/Driftline.Licensing.csproj --configuration Release --output artifacts/nuget",
    "contracts:bundle": "node tools/build-metatweak-integration-bundle.mjs",
    "contracts:fixtures": "node tools/generate-licensing-test-vectors.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
